{
	admin off
	persist_config off
}

:3000 {
	root * /site/selfhost-web
	@asset {
		file
		not path / /index.html
	}
	handle @asset {
		file_server
	}
	handle {
		root * {$HOPP_RUNTIME_DIR:/tmp/hopp-site}/selfhost-web
		rewrite * /index.html
		file_server
	}
}

:3100 {
	root * /site/sh-admin-multiport-setup
	@asset {
		file
		not path / /index.html
	}
	handle @asset {
		file_server
	}
	handle {
		root * {$HOPP_RUNTIME_DIR:/tmp/hopp-site}/sh-admin-multiport-setup
		rewrite * /index.html
		file_server
	}
}

:3170 {
	@mock {
		header_regexp host Host ^[^.]+\.mock\..*$
	}
	
	handle @mock {
		rewrite * /mock{uri}
		reverse_proxy localhost:8080
	}
	
	handle {
		reverse_proxy localhost:8080
	}
}

{
  admin off
  persist_config off
}

:{$HOPP_ALTERNATE_PORT:80} {
	# Admin dashboard under `/admin*`
	handle_path /admin* {
		root * /site/sh-admin-subpath-access
		@asset {
			file
			not path / /index.html
		}
		handle @asset {
			file_server
		}
		handle {
			root * {$HOPP_RUNTIME_DIR:/tmp/hopp-site}/sh-admin-subpath-access
			rewrite * /index.html
			file_server
		}
	}

	# Handle requests under `/backend*` path
	handle_path /backend* {
		@mock {
			header_regexp host Host ^[^.]+\.mock\..*$
		}

		handle @mock {
			rewrite * /mock{uri}
			reverse_proxy localhost:8080
		}

		handle {
			reverse_proxy localhost:8080
		}
	}

	# Handle requests under `/desktop-app-server*` path
	handle_path /desktop-app-server* {
		reverse_proxy localhost:3200
	}

	# Default: the `selfhost-web` SPA — immutable hashed assets from the read-only
	# /site, and the runtime-env-rendered entry document (plus SPA fallbacks) from a
	# writable directory.
	handle {
		root * /site/selfhost-web
		@asset {
			file
			not path / /index.html
		}
		handle @asset {
			file_server
		}
		handle {
			root * {$HOPP_RUNTIME_DIR:/tmp/hopp-site}/selfhost-web
			rewrite * /index.html
			file_server
		}
	}
}

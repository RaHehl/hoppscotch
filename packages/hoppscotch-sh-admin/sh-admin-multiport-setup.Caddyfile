{
  admin off
  persist_config off
}

:{$HOPP_ALTERNATE_PORT:80} :3100 {
	root * /site/sh-admin-multiport-setup

	# Hashed assets are served immutably from the shipped, read-only /site.
	@asset {
		file
		not path / /index.html
	}
	handle @asset {
		file_server
	}

	# The entry document (and SPA fallbacks) is the runtime-env-rendered index.html
	# from a writable directory, so /site never has to be written to at runtime.
	handle {
		root * {$HOPP_RUNTIME_DIR:/tmp/hopp-site}/sh-admin-multiport-setup
		rewrite * /index.html
		file_server
	}
}
